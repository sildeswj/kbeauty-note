{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kbeauty-note",
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "kbeauty.jworld.dev",
      "custom_domain": true
    }
  ]
}
