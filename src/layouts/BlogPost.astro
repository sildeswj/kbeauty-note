---
import type { MarkdownHeading } from 'astro';
import AuthorBox from '../components/AuthorBox.astro';
import Cover from '../components/Cover.astro';
import NewsletterSubscribe from '../components/NewsletterSubscribe.astro';
import PostCard from '../components/PostCard.astro';
import Share from '../components/Share.astro';
import Toc from '../components/Toc.astro';
import TravelPrepBox from '../components/TravelPrepBox.astro';
import { categoryOf, fmtDate, getPosts, isPlaceholder, readingMinutes, related, type Post } from '../lib/posts';
import Base from './Base.astro';

interface Props {
	post: Post;
	headings: MarkdownHeading[];
}
const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
const cat = categoryOf(post);
const all = await getPosts();
const more = related(all, post, 3);
const idx = all.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? all[idx - 1] : undefined;
const older = idx < all.length - 1 ? all[idx + 1] : undefined;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	inLanguage: 'es',
	mainEntityOfPage: url,
	author: { '@type': 'Person', name: 'J', jobTitle: 'Editor de K-BEAUTY NOTE', homeLocation: 'Seoul, Korea', url: 'https://kbeauty.jworld.dev/about/' },
	publisher: { '@type': 'Organization', name: 'JWorld', url: 'https://jworld.dev' },
};
---

<Base title={`${title} | K-BEAUTY NOTE`} description={description} image={heroImage} type="article" jsonLd={jsonLd}>
	<main class="post">
		<article>
			<header class="head">
				<nav class="crumbs" aria-label="Ruta de navegación">
					<a href="/">Inicio</a><span>/</span><a href={`/category/${cat.slug}/`}>{cat.label}</a>
				</nav>
				<h1>{title}</h1>
				<p class="lead">{description}</p>
				<div class="byline">
					<span class="meta">
						{fmtDate(pubDate)}
						{updatedDate && <> · Actualizado {fmtDate(updatedDate)}</>} · {readingMinutes(post)} min de lectura · Por J (desde Seúl)
					</span>
				</div>
				<p class="pr-note"><b>NOTA</b>Este artículo puede incluir enlaces informativos o de afiliados a tiendas internacionales. Si realizas una compra a través de ellos, el sitio puede recibir una pequeña comisión sin costo adicional para ti.</p>
			</header>

			<div class="hero">
				<Cover post={post} size={isPlaceholder(post) ? 'banner' : 'lg'} eager />
				{post.data.heroAi && !isPlaceholder(post) && <p class="hero-cap">※ Imagen ilustrativa generada con IA. No representa un envase ni tienda específica.</p>}
			</div>

			<div class="col">
				<Toc headings={headings} />
				<TravelPrepBox category={cat.slug} title={title} slug={post.id} variant="inline" />
				<div class="prose">
					<slot />
				</div>

				<div class="after">
					<TravelPrepBox category={cat.slug} title={title} slug={post.id} variant="full" />
					<Share url={url} title={title} />
					<AuthorBox />
					<p class="note">※ Los precios de referencia (en wones coreanos o dólares), formulaciones y rankings corresponden a la fecha de publicación. Consulta siempre la información oficial del fabricante y un dermatólogo si tienes condiciones específicas en la piel.</p>
				</div>

				<nav class="pager" aria-label="Artículos anterior y siguiente">
					{older ? <a href={`/blog/${older.id}/`} class="prev"><span class="meta">← Artículo anterior</span><span class="pt">{older.data.title}</span></a> : <span />}
					{newer ? <a href={`/blog/${newer.id}/`} class="next"><span class="meta">Artículo siguiente →</span><span class="pt">{newer.data.title}</span></a> : <span />}
				</nav>
			</div>
		</article>

		{
			more.length > 0 && (
				<section class="wrap rel">
					<div class="section-head">
						<h2>Artículos relacionados</h2>
						<a href="/blog/" class="more">Ver todos →</a>
					</div>
					<div class="rel-grid">
						{more.map((p) => (
							<PostCard post={p} />
						))}
					</div>
				</section>
			)
		}

		<div class="wrap nl">
			<NewsletterSubscribe />
		</div>
	</main>
</Base>

<style>
	.head,
	.col {
		width: min(var(--measure), calc(100% - 40px));
		margin-inline: auto;
	}
	.head {
		padding-top: 48px;
		text-align: center;
	}
	.crumbs {
		font-size: 12px;
		color: var(--ink-3);
		display: flex;
		justify-content: center;
		gap: 8px;
		letter-spacing: 0.06em;
	}
	.crumbs a:hover {
		color: var(--accent);
	}
	.crumbs a:last-child {
		color: var(--accent);
		font-weight: 700;
	}
	h1 {
		margin-top: 18px;
		font-size: clamp(25px, 3.6vw, 36px);
		line-height: 1.4;
	}
	.lead {
		margin: 16px auto 0;
		max-width: 620px;
		font-size: 15px;
		line-height: 1.8;
		color: var(--ink-2);
	}
	.byline {
		margin-top: 18px;
	}
	.pr-note {
		margin: 12px 0 0;
		font-size: 12px;
		color: var(--ink-3);
		line-height: 1.6;
	}
	.pr-note b {
		display: inline-block;
		margin-right: 6px;
		padding: 0 6px;
		border: 1px solid var(--ink-3);
		border-radius: 4px;
		font-size: 11px;
	}
	.hero-cap {
		margin: 8px 0 0;
		font-size: 11.5px;
		color: var(--ink-3);
		text-align: right;
	}
	.hero {
		width: min(960px, calc(100% - 40px));
		margin: 36px auto 40px;
	}
	.col > :global(.toc) {
		margin-bottom: 36px;
	}
	.after {
		margin-top: 56px;
		display: grid;
		gap: 22px;
	}
	.note {
		margin: 0;
		font-size: 12px;
		color: var(--ink-3);
		line-height: 1.8;
	}
	.pager {
		margin-top: 40px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
	}
	.pager a {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 16px 18px;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--surface);
	}
	.pager .next {
		text-align: right;
	}
	.pager a:hover {
		border-color: var(--ink);
	}
	.pt {
		font-size: 13.5px;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.rel-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
	}
	.nl {
		margin-top: 64px;
	}
	@media (max-width: 860px) {
		.rel-grid {
			grid-template-columns: 1fr;
			gap: 28px;
		}
	}
	@media (max-width: 600px) {
		.head {
			text-align: left;
			padding-top: 28px;
		}
		.crumbs {
			justify-content: flex-start;
		}
		.lead {
			margin-left: 0;
		}
		.hero {
			width: 100%;
			margin: 24px 0 28px;
		}
		.hero :global(.cover) {
			border-radius: 0;
		}
		.pager {
			grid-template-columns: 1fr;
		}
	}
</style>
