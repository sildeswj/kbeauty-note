---
interface Props {
	category?: string;
}
const { category = 'rutinas' } = Astro.props;

const items = [
	{
		tag: 'Tienda Oficial · Envío Global',
		title: 'Olive Young Global — Los más vendidos en Corea',
		desc: 'Consulta los rankings oficiales de Seúl con envío internacional directo a Latinoamérica, España y EE. UU.',
		href: 'https://global.oliveyoung.com/',
		cta: 'Ver en Olive Young →',
	},
	{
		tag: 'Catálogo K-Beauty en Español',
		title: 'YesStyle — Cosmética Coreana y Maquillaje de K-Drama',
		desc: 'Gran variedad de marcas coreanas (COSRX, Beauty of Joseon, SKIN1004, Anua, Rom&nd) con reseñas en español.',
		href: 'https://www.yesstyle.com/es/k-beauty',
		cta: 'Explorar K-Beauty →',
	},
	{
		tag: 'Cultura Coreana Interactiva · Gratis',
		title: 'Dokkaebi Night Parade (도깨비 야행) — Juego Web de Folclore Coreano',
		desc: '¿Te gusta la mitología de los K-Dramas de fantasía? Prueba nuestro minijuego gratuito directamente en tu navegador.',
		href: 'https://games.jworld.dev/dokkaebi/',
		cta: 'Jugar Gratis →',
	},
];
---

<aside class="prep-box" aria-label="Dónde encontrar productos de K-Beauty desde casa">
	<div class="prep-head">
		<span class="prep-badge">GUÍA K-BEAUTY EN CASA</span>
		<h3 class="prep-title">Dónde encontrar cosmética coreana original sin viajar a Seúl</h3>
		<p class="prep-sub">
			Para evitar imitaciones, te recomendamos verificar siempre distribuidores internacionales autorizados o las tiendas globales oficiales.
		</p>
	</div>
	<div class="prep-list">
		{
			items.map((item) => (
				<a href={item.href} target="_blank" rel="noopener" class="prep-card">
					<div class="prep-card-main">
						<span class="prep-tag">{item.tag}</span>
						<span class="prep-name">{item.title}</span>
						<span class="prep-desc">{item.desc}</span>
					</div>
					<span class="prep-cta">{item.cta}</span>
				</a>
			))
		}
	</div>
	<p class="prep-foot">
		※ Las condiciones de envío internacional, aduanas y disponibilidad varían según tu país (México, España, Colombia, Argentina, Chile, Perú o EE. UU.). Revisa siempre los detalles en el sitio oficial antes de comprar.
	</p>
</aside>

<style>
	.prep-box {
		padding: 24px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}
	.prep-head {
		margin-bottom: 16px;
	}
	.prep-badge {
		display: inline-block;
		font-size: 10.5px;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--accent);
		border: 1px solid var(--line);
		background: var(--bg);
		padding: 2px 8px;
		border-radius: 4px;
	}
	.prep-title {
		margin: 8px 0 4px;
		font-family: var(--serif);
		font-size: 17px;
		line-height: 1.5;
		color: var(--ink);
	}
	.prep-sub {
		margin: 0;
		font-size: 13px;
		line-height: 1.75;
		color: var(--ink-2);
	}
	.prep-list {
		display: grid;
		gap: 10px;
	}
	.prep-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 14px 16px;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		text-decoration: none;
		transition: border-color 0.15s ease;
	}
	.prep-card:hover {
		border-color: var(--accent);
	}
	.prep-card-main {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}
	.prep-tag {
		font-size: 11px;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: 0.04em;
	}
	.prep-name {
		font-family: var(--serif);
		font-weight: 700;
		font-size: 14.5px;
		color: var(--ink);
		line-height: 1.45;
	}
	.prep-desc {
		font-size: 12.5px;
		color: var(--ink-2);
		line-height: 1.65;
	}
	.prep-cta {
		flex-shrink: 0;
		font-size: 12.5px;
		font-weight: 700;
		color: var(--accent);
		white-space: nowrap;
	}
	.prep-foot {
		margin: 12px 0 0;
		font-size: 11.5px;
		color: var(--ink-3);
		line-height: 1.6;
	}
	@media (max-width: 600px) {
		.prep-box {
			padding: 18px;
		}
		.prep-card {
			flex-direction: column;
			align-items: flex-start;
			gap: 8px;
		}
	}
</style>
